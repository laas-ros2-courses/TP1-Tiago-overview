<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiago_go_to_point</name>
  <version>0.0.0</version>
  <description>Action GoToPoint pour TIAGo (serveur+client) -- portage du TD2 turtlesim sur la base mobile simulee (odom + mobile_base_controller)</description>
  <maintainer email="pene.clement@gmail.com">cpene</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tiago_go_to_point_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
